{
  "name": "starburst",
  "private": true,
  "version": "2.1.1",
  "description": "STARBURST: a neon pixel-art bullet hell for the browser (Phaser 3 + Vite)",
  "license": "MIT",
  "author": "Kiril Petrovski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiril-P/starburst.git"
  },
  "homepage": "https://kirilp.itch.io/starburst",
  "bugs": {
    "url": "https://github.com/Kiril-P/starburst/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:online": "VITE_API_URL=https://starburst-api.kirilp.workers.dev vite build",
    "preview": "vite preview",
    "check": "node tools/check.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "test:smoke:prod": "node tools/smoke.mjs --prod",
    "trailer": "node tools/make-trailer.mjs",
    "gif": "node tools/make-gif.mjs",
    "icons": "node tools/make-favicon.mjs",
    "bot": "node tools/bot.mjs",
    "bot:report": "node tools/bot/report.mjs",
    "compliance": "node tools/compliance.mjs",
    "test:server": "node --test server/test",
    "test:online": "node tools/online-smoke.mjs",
    "server:dev": "node server/dev.mjs",
    "telemetry": "node tools/telemetry-report.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "3.90"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  }
}
